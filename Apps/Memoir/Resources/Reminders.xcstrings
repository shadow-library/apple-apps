    },
    "A quest you complete on another device stops reminding here once the change syncs; a reminder due before then may still arrive.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quest you complete on another device stops reminding here once the change syncs; a reminder due before then may still arrive."
