    "%lld moves a week is the cap on %@ quests. Past it a move is recorded as a postpone instead of disappearing, so the history stays honest either way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld moves a week is the cap on %@ quests. Past it a move is recorded as a postpone instead of disappearing, so the history stays honest either way."
          }
        }
      }
    },
    "%lld moves a week is the cap on %@ quests. Past it a move is recorded as a postpone instead of disappearing, so the history stays honest either way. The cap frees up for occurrences from %@.": {
