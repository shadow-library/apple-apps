    },
    "This device's sync settings could not be read, so sync stopped. Turn it on again to choose where your %@ syncs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's sync settings could not be read, so sync stopped. Turn it on again to choose where your %@ syncs."
